# ── Server ────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://workspaceapi.myenum.in
NEXT_PUBLIC_APP_URL=https://workspaceapi.myenum.in

# ── Database & Cache ──────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/workspace
REDIS_URL=

# ── Authentication ────────────────────────────
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
COOKIE_SECRET=generate-with-openssl-rand-hex-32
COOKIE_SECURE=true

# ── Google OAuth ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@myenum.in

# ── Cloudflare R2 (file storage) ──────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Super Admins ──────────────────────────────
SUPER_ADMIN_EMAILS=developer@myenum.in

# ── Cloudflare Tunnel ─────────────────────────
TUNNEL_TOKEN=
